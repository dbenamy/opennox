{
  "batch": "reliable-reports",
  "env": {
    "OPENNOX_SPELLBOOK_CAPTURE": "{out}/capture",
    "NOX_DATA": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_SPELLBOOK_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_MAP_DECODE_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_CLIENT_AUDIO_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_BRIEFING_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_SHOP_UI_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_TRADE_UI_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_MAP_CATALOG_ASSETS": "{root}/build/assets/extracted/drive_c/Nox"
  },
  "phases": {
    "production": [
      {
        "name": "compressor-build",
        "cwd": "{root}/src",
        "command": [
          "go",
          "build",
          "-p",
          "2",
          "-o",
          "{out}/map-compress",
          "{root}/tools/porting/map_compress.go"
        ]
      },
      {
        "name": "production",
        "command": [
          "python3",
          "{root}/tools/porting/qualify_production.py",
          "{root}/docs/porting/reliable-reports-c-production.json",
          "--out",
          "{out}/production"
        ]
      },
      {
        "name": "flat-gameplay",
        "command": [
          "env",
          "OPENNOX_DISPLAY_BINARY={out}/production/bin/opennox",
          "OPENNOX_UI_SCENARIO={root}/docs/porting/tile-raster-flat.yaml",
          "OPENNOX_DISPLAY_IMPLEMENTATION=Reliable message queue C pressure correction",
          "OPENNOX_REQUIRE_MAP_DECOMPRESSION=1",
          "OPENNOX_COMPRESS_MAPS=[\"war01a/War01A.map\"]",
          "OPENNOX_MAP_COMPRESSOR={out}/map-compress",
          "python3",
          "{root}/tools/porting/run_scenario.py",
          "reliable-reports-flat-c",
          "compare",
          "{root}/build/baseline/runs/object-reports-flat-native"
        ]
      }
    ]
  },
  "production": {
    "description": "Reliable message queue C pressure correction",
    "assets": "build/assets/extracted/drive_c/Nox",
    "known_suite": "build/port-rule-command/full-suite.jsonl",
    "scenario_runner": "tools/porting/run_scenario.py",
