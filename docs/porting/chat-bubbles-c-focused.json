{
  "batch": "chat-bubbles-c-focused",
  "env": {
    "OPENNOX_SPELLBOOK_CAPTURE": "{out}/capture",
    "NOX_DATA": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_SPELLBOOK_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_MAP_DECODE_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_CLIENT_AUDIO_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_BRIEFING_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_SHOP_UI_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_TRADE_UI_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_MAP_CATALOG_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_COMBAT_CAPTURE": "{out}/combat.json",
    "OPENNOX_MAP_POPULATION_CAPTURE": "{out}/population"
  },
  "phases": {
    "default": [
      {
        "name": "default",
        "command": [
          "python3",
          "{root}/tools/porting/run_tests.py",
          "--pattern-file",
          "{root}/docs/porting/chat-bubbles-focused-tests.txt",
          "--tags",
          "porttest",
          "--package",
          ".",
          "--log",
          "{out}/tests.jsonl",
          "--result",
          "{out}/tests-result.json",
          "--require-no-skips"
        ]
      }
    ],
    "server": [
      {
        "name": "server",
        "command": [
          "python3",
          "{root}/tools/porting/run_tests.py",
          "--pattern-file",
          "{root}/docs/porting/chat-bubbles-focused-tests.txt",
          "--tags",
          "porttest,server",
          "--package",
          ".",
          "--log",
          "{out}/tests.jsonl",
          "--result",
          "{out}/tests-result.json",
          "--require-no-skips"
        ]
      }
    ],
    "highres": [
      {
        "name": "highres",
        "command": [
          "python3",
          "{root}/tools/porting/run_tests.py",
          "--pattern-file",
          "{root}/docs/porting/chat-bubbles-focused-tests.txt",
          "--tags",
          "porttest,highres",
          "--package",
          ".",
          "--log",
          "{out}/tests.jsonl",
          "--result",
          "{out}/tests-result.json",
          "--require-no-skips"
        ]
      }
    ]
  }
}
