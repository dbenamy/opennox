          "env",
          "GOGC=1",
          "{out}/server.test",
          "-test.v=test2json",
          "-test.count=20",
          "-test.timeout=300s",
          "-test.run=^TestServerOrchestrationPlayerReset$"
        ]
      },
      {
        "name": "highres-build",
        "cwd": "{root}/src",
        "command": [
          "env",
          "GOGC=100",
