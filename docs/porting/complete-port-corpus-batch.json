          "GOGC=1",
          "{out}/highres.test",
          "-test.v=test2json",
          "-test.count=20",
          "-test.timeout=300s",
          "-test.run=^TestServerOrchestrationPlayerReset$"
        ]
      },
      {
        "name": "static",
        "cwd": "{root}/src",
        "command": [
          "go",
          "test",
          "./common/memmap/nox",
          "-run",
