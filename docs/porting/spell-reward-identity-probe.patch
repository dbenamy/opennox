@@ -0,0 +1,89 @@
+//go:build porttest
+
+package legacy
+
+import (
+	"encoding/json"
+	"os"
+	"unsafe"
+)
+
+type portTestSpellRewardIdentityProbe struct {
+	path          string
+	addresses     map[uint32]uint32
+	registrations map[uint32]uint32
+	generated     map[uint32]uint64
+	hits          map[string]map[uint32]uint64
+	ops           map[uint32]uint64
+	lookups       uint64
+	flushes       uint64
+	maps          [][3]int
+}
+
+func newPortTestSpellRewardIdentityProbe() *portTestSpellRewardIdentityProbe {
+	path := os.Getenv("OPENNOX_SPELL_REWARD_IDENTITY_PROBE")
+	if path == "" {
+		return nil
+	}
+	return &portTestSpellRewardIdentityProbe{path: path, addresses: make(map[uint32]uint32), registrations: make(map[uint32]uint32), generated: make(map[uint32]uint64), hits: make(map[string]map[uint32]uint64), ops: make(map[uint32]uint64)}
+}
+func (p *portTestSpellRewardIdentityProbe) function(ptr unsafe.Pointer, id uint32) {
+	raw := uint32(uintptr(ptr))
+	if raw == 0 {
+		panic("nil function address")
+	}
+	if old, ok := p.addresses[raw]; ok && old != id {
+		panic("function address alias")
+	}
+	p.addresses[raw] = id
+	p.registrations[id] = raw
+}
+func (p *portTestSpellRewardIdentityProbe) register(ptr unsafe.Pointer, id uint32) {
+	if id >= 90000 {
+		p.generated[id]++
+	}
+}
+func (p *portTestSpellRewardIdentityProbe) normalizeHit(table string, key, id uint32) {
+	p.lookups++
+	target, ok := p.addresses[key]
+	if !ok {
+		return
+	}
+	if p.hits[table] == nil {
+		p.hits[table] = make(map[uint32]uint64)
+	}
+	p.hits[table][target]++
+}
+func (p *portTestSpellRewardIdentityProbe) normalizeMiss(key uint32) { p.lookups++ }
+func (p *portTestSpellRewardIdentityProbe) observeShopMaps(shop, life, reserved int) {
+	p.maps = append(p.maps, [3]int{shop, life, reserved})
+}
+func (p *portTestSpellRewardIdentityProbe) flush() {
+	if p == nil {
+		return
+	}
+	p.flushes++
+	row := struct {
+		Flush         uint64
+		Registrations map[uint32]uint32
+		Hits          map[string]map[uint32]uint64
+		Operations    map[uint32]uint64
+		Generated     map[uint32]uint64
+		Lookups       uint64
+		MapSizes      [][3]int
+	}{p.flushes, p.registrations, p.hits, p.ops, p.generated, p.lookups, p.maps}
+	data, err := json.Marshal(row)
+	if err != nil {
+		panic(err)
+	}
+	f, err := os.OpenFile(p.path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0600)
+	if err != nil {
+		panic(err)
+	}
+	if _, err = f.Write(append(data, '\n')); err != nil {
+		panic(err)
+	}
+	if err = f.Close(); err != nil {
+		panic(err)
+	}
+}
