    "c-gameplay": [
      {
        "name": "client-build",
        "cwd": "{root}/src",
        "command": [
          "go",
          "build",
          "-p",
          "2",
          "-o",
          "{out}/client",
          "./cmd/opennox"
        ]
      },
      {
        "name": "compressor-build",
        "cwd": "{root}/src",
        "command": [
          "go",
          "build",
          "-p",
          "2",
          "-o",
          "{out}/map-compress",
          "{root}/tools/porting/map_compress.go"
        ]
      },
      {
        "name": "capture",
        "command": [
          "env",
          "NOX_DEV=true",
          "OPENNOX_UI_SCENARIO={root}/docs/porting/quickbar-warrior.yaml",
          "OPENNOX_DISPLAY_BINARY={out}/client",
          "OPENNOX_DISPLAY_IMPLEMENTATION=Quickbar C with saved-row correction",
          "OPENNOX_REQUIRE_MAP_DECOMPRESSION=1",
          "OPENNOX_COMPRESS_MAPS=[\"war01a/War01A.map\"]",
          "OPENNOX_MAP_COMPRESSOR={out}/map-compress",
          "python3",
          "{root}/tools/porting/run_scenario.py",
          "quickbar-c",
          "capture"
        ]
      },
      {
        "name": "repeat",
        "command": [
          "env",
          "NOX_DEV=true",
          "OPENNOX_UI_SCENARIO={root}/docs/porting/quickbar-warrior.yaml",
          "OPENNOX_DISPLAY_BINARY={out}/client",
          "OPENNOX_DISPLAY_IMPLEMENTATION=Quickbar C with saved-row correction",
          "OPENNOX_REQUIRE_MAP_DECOMPRESSION=1",
          "OPENNOX_COMPRESS_MAPS=[\"war01a/War01A.map\"]",
          "OPENNOX_MAP_COMPRESSOR={out}/map-compress",
          "python3",
          "{root}/tools/porting/run_scenario.py",
          "quickbar-c-repeat",
          "compare",
          "{root}/build/baseline/runs/quickbar-c"
        ]
      }
