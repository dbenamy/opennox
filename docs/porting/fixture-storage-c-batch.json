{
  "batch": "fixture-storage-c",
  "env": {
    "GOMAXPROCS": "2",
    "GOMEMLIMIT": "768MiB",
    "OPENNOX_SCALAR_STORAGE_CAPTURE": "{out}/scalar-storage.json",
    "NOX_DATA": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_BRIEFING_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_CLIENT_AUDIO_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_MAP_CATALOG_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_SHOP_UI_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_SPELLBOOK_ASSETS": "{root}/build/assets/extracted/drive_c/Nox",
    "OPENNOX_TRADE_UI_ASSETS": "{root}/build/assets/extracted/drive_c/Nox"
  },
  "phases": {
    "default": [
      {
        "name": "contracts",
        "command": [
          "python3",
          "{root}/tools/porting/run_tests.py",
          "--pattern-file",
          "{root}/docs/porting/fixture-storage-tests.txt",
          "--tags",
          "porttest",
          "--package",
          "./legacy",
          "--log",
          "{out}/tests.log",
          "--result",
          "{out}/tests.json",
          "--require-no-skips"
        ],
        "hashes": [
          {
            "path": "{out}/scalar-storage.json",
            "sha256": "6de9fccecf723a0f1e0693560cc57abcf5eac137eebbaac634b771dfd7aa6b2b"
          }
        ]
      },
      {
        "name": "consumers",
        "command": [
          "python3",
          "{root}/tools/porting/run_tests.py",
          "--pattern-file",
          "{root}/docs/porting/fixture-storage-consumers.txt",
          "--tags",
          "porttest",
          "--package",
          ".",
          "--log",
          "{out}/consumers.log",
          "--result",
          "{out}/consumers.json",
          "--require-no-skips"
        ]
      },
      {
        "name": "static",
        "cwd": "{root}/src",
        "command": [
          "go",
          "test",
          "./common/memmap/nox",
          "-run",
          "^TestCodeStatic$",
          "-count=1"
        ]
      }
    ],
    "server": [
      {
        "name": "contracts",
        "command": [
          "python3",
          "{root}/tools/porting/run_tests.py",
          "--pattern-file",
          "{root}/docs/porting/fixture-storage-tests.txt",
          "--tags",
          "porttest,server",
          "--package",
          "./legacy",
          "--log",
          "{out}/tests.log",
          "--result",
          "{out}/tests.json",
          "--require-no-skips"
        ],
        "hashes": [
          {
            "path": "{out}/scalar-storage.json",
            "sha256": "6de9fccecf723a0f1e0693560cc57abcf5eac137eebbaac634b771dfd7aa6b2b"
          }
        ]
      },
      {
        "name": "static",
        "cwd": "{root}/src",
        "command": [
          "go",
          "test",
          "./common/memmap/nox",
          "-run",
          "^TestCodeStatic$",
          "-count=1"
        ]
      }
    ],
    "highres": [
      {
        "name": "contracts",
        "command": [
          "python3",
          "{root}/tools/porting/run_tests.py",
          "--pattern-file",
          "{root}/docs/porting/fixture-storage-tests.txt",
          "--tags",
          "porttest,highres",
          "--package",
          "./legacy",
          "--log",
          "{out}/tests.log",
          "--result",
          "{out}/tests.json",
          "--require-no-skips"
        ],
        "hashes": [
          {
            "path": "{out}/scalar-storage.json",
            "sha256": "6de9fccecf723a0f1e0693560cc57abcf5eac137eebbaac634b771dfd7aa6b2b"
          }
        ]
      },
      {
        "name": "static",
        "cwd": "{root}/src",
        "command": [
          "go",
          "test",
          "./common/memmap/nox",
          "-run",
          "^TestCodeStatic$",
          "-count=1"
        ]
      }
    ],
    "repeat": [
      {
        "name": "contracts",
        "command": [
          "python3",
          "{root}/tools/porting/run_tests.py",
          "--pattern-file",
          "{root}/docs/porting/fixture-storage-tests.txt",
          "--tags",
          "porttest",
          "--package",
          "./legacy",
          "--log",
          "{out}/tests.log",
          "--result",
          "{out}/tests.json",
          "--require-no-skips"
        ],
        "hashes": [
          {
            "path": "{out}/scalar-storage.json",
            "sha256": "6de9fccecf723a0f1e0693560cc57abcf5eac137eebbaac634b771dfd7aa6b2b"
          }
        ]
      },
      {
        "name": "static",
        "cwd": "{root}/src",
        "command": [
          "go",
          "test",
          "./common/memmap/nox",
          "-run",
          "^TestCodeStatic$",
          "-count=1"
        ]
      }
    ]
  }
}
