          "--result",
          "{out}/tests-result.json",
          "--require-no-skips"
        ]
      }
    ],
    "highres": [
      {
        "name": "highres",
        "command": [
          "python3",
          "{root}/tools/porting/run_tests.py",
          "--pattern-file",
          "{root}/docs/porting/script-bindings-prerequisite-tests.txt",
          "--tags",
