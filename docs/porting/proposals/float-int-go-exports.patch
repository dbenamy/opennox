+package legacy
+
+/*
+#include "GAME1_1.h"
+*/
+import "C"
+
+import "math"
+
+func floatToInt32(value float32) int32 {
+	// Preserve the masked x87 invalid-conversion result for NaN, infinity
+	// and out-of-range values instead of relying on Go's target conversion.
+	if !(value >= -2147483648 && value < 2147483648) {
+		return -2147483648
+	}
+	return int32(value)
+}
+
+//export nox_float2int
+func nox_float2int(value C.float) C.int {
+	return C.int(floatToInt32(float32(value)))
+}
+
+//export nox_float2int16
+func nox_float2int16(value C.float) C.short {
+	return C.short(int16(floatToInt32(float32(value))))
+}
+
+//export nox_float2int16_abs
+func nox_float2int16_abs(value C.float) C.short {
+	abs := math.Float32frombits(math.Float32bits(float32(value)) & 0x7fffffff)
+	return C.short(int16(floatToInt32(abs)))
+}
